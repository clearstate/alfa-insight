# Скопировать в .env (не коммитить). Секреты — только здесь или в секретах платформы.
ALFA_PORT=8080
# Опорная дата демонстрации (данные кейса датированы сен–окт 2026). Для «живой» эксплуатации — пустое значение недопустимо, задать текущую дату.
ALFA_AS_OF=2026-10-21
# Ключ подписи демо-токенов. Если пусто — генерируется при старте (токены не переживают перезапуск).
ALFA_SECRET=
# --- LLM (необязательно). Без этих переменных сервис работает в режиме правил, без обращений к моделям. ---
# Шлюз организаторов: OpenAI-совместимый /chat/completions. Точные идентификаторы моделей уточнить у шлюза.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_SIMPLE=gemma-4-26b-a4b
LLM_MODEL_REASON=glm-5.3-flash
LLM_MODEL_GENERAL=qwen3.6-35b-a3b
# Дневной лимит токенов на сервис (общий лимит команды — 500 ₽/сутки; подберите под тариф)
LLM_DAILY_TOKEN_BUDGET=150000
# LLM_ENABLED=0   # принудительно выключить модель
# ALFA_CORS_ORIGIN=   # нужен только если интерфейс отдаётся с другого origin; vite-разработка использует proxy
