# Скопировать в .env (не коммитить). Секреты — только здесь или в секретах платформы.
ALFA_PORT=8080
# Опорная дата. Пусто — сегодня (с живыми лентами); без живых лент по умолчанию 2026-10-21 (даты данных кейса).
ALFA_AS_OF=
# Живые ленты (по умолчанию 1): приложение само обходит включённые RSS из services/news_ingest/config/sources.yaml
# (Банк России, Интерфакс, РБК, ТАСС) каждые interval_min минут и добавляет материалы в ленту; свежесть — /api/health (kb.feeds).
# 0 — офлайн-режим: воспроизводимая синтетическая демо-лента на дату ALFA_AS_OF (сценарий docs/DEMO_SCRIPT.md).
ALFA_LIVE_FEEDS=1
# Синтетические демо-новости: по умолчанию только при ALFA_LIVE_FEEDS=0 (рядом с реальными новостями вымышленные события
# могут ввести в заблуждение). 1 — показывать всегда (помечены «синтетическая демо-новость»), 0 — никогда.
# ALFA_DEMO_NEWS=
# Ключ подписи демо-токенов. Если пусто — генерируется при старте (токены не переживают перезапуск).
ALFA_SECRET=
# --- LLM (необязательно). Без этих переменных сервис работает в режиме правил, без обращений к моделям. ---
# Шлюз организаторов: OpenAI-совместимый /chat/completions. Ключ (sk-…) — только в .env, не в этом файле.
# Модели шлюза: google/gemma-4-26b-a4b-it, z-ai/glm-5.3-flash, qwen/qwen3.6-35b-a3b, deepseek/deepseek-v4.1-flash,
# qwen/qwen3-vl-30b-a3b-instruct, moonshotai/kimi-k2.6
LLM_BASE_URL=https://changellenge.up.railway.app/v1
LLM_API_KEY=
LLM_MODEL_SIMPLE=google/gemma-4-26b-a4b-it
LLM_MODEL_REASON=z-ai/glm-5.3-flash
LLM_MODEL_GENERAL=qwen/qwen3.6-35b-a3b
# Лимиты сервиса на сутки (сброс в 03:00 МСК). Бюджет шлюза — 500 ₽/сутки на всю команду: оставьте запас коллегам.
LLM_DAILY_COST_BUDGET=300
LLM_DAILY_TOKEN_BUDGET=3000000
# Сколько верхних карточек ленты готовить моделью заранее (0 — только при открытии разбора)
LLM_PREWARM=3
# Запасной адрес шлюза (используется при сетевой ошибке основного)
LLM_BASE_URL_FALLBACK=https://api.alfahack-gateway26.ru/v1
# LLM_ENABLED=0   # принудительно выключить модель
# ALFA_CORS_ORIGIN=   # нужен только если интерфейс отдаётся с другого origin; vite-разработка использует proxy
# --- news_ingest (docker-compose.news_ingest.yml) ---
POSTGRES_PASSWORD=
# Токены API: «user_id:sha256(токена)» через запятую — только хеши (python -m services.news_ingest.cli gen-token USER_ID)
NEWS_API_TOKENS=
# Кому разрешено запускать ингест (POST /api/news/ingest), через запятую
NEWS_INGEST_USERS=
# Адрес публикации порта API. По умолчанию только 127.0.0.1; 0.0.0.0 — лишь за reverse-proxy с TLS и ограничением доступа
# NEWS_INGEST_BIND=127.0.0.1
# Белый список доменов для ингеста по URL (через запятую); пусто — любые публичные адреса
# NEWS_ALLOWED_DOMAINS=
