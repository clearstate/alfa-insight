# news_ingest (участник 2): конвейер новостей + API. Не собирался в среде разработки (нет Docker/сети) — собрать и проверить на стенде.
FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-rus tesseract-ocr-eng poppler-utils \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
# Версии: общий uv.lock проекта (fastapi/pydantic/psycopg/pandas) + точные версии библиотек модуля.
COPY pyproject.toml requirements.news_ingest.lock.txt ./
RUN pip install --no-cache-dir "pandas>=2.2,<4" "numpy>=2,<3" "PyYAML>=6,<7" "fastapi>=0.115,<1" "pydantic>=2.7,<3" \
        "uvicorn[standard]>=0.30,<1" "psycopg[binary]>=3.2,<4" -r requirements.news_ingest.lock.txt
COPY contracts ./contracts
COPY services ./services
COPY scripts ./scripts
COPY data/bank_analytics ./data/bank_analytics
RUN useradd --system --uid 10001 app && mkdir -p /app/data && chown -R app /app
USER app
EXPOSE 8002
ENV NEWS_DB_URL=sqlite:////app/data/news_ingest.db NEWS_BOOTSTRAP_BANK=1 NEWS_STANDALONE_AUTH=demo
CMD ["uvicorn", "services.news_ingest.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8002"]
